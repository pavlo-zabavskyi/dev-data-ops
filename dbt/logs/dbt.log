    ) AS relations_with_metadata
    JOIN (
        SELECT
            name AS principal_name,
            principal_id AS principal_id
        FROM
            sys.database_principals 
    ) AS principals ON relations_with_metadata.owner_principal_id = principals.principal_id


            

